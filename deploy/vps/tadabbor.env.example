# Settings of the Tadabbor accounts server. Only the tadabbor-api service reads this file (it is chmod 600).
# After a change: sudo systemctl restart tadabbor-api
# (systemd does not allow a comment at the end of a value line, so comments stay on their own lines)

# Filled in by install.sh with a random value. Do not change it later, or codes already sent stop working.
OTP_SECRET=

# How the SMS code is sent: log (testing only: the code is written to `journalctl -u tadabbor-api`), kavenegar, smsir
SMS_PROVIDER=log
SMS_API_KEY=
# kavenegar: the name of the verify template. sms.ir: the template id (a number).
SMS_TEMPLATE=
# sms.ir only: the name of the parameter in the template, e.g. CODE
SMS_PARAM=CODE
# 1 = show phone sign-in in the app even while SMS_PROVIDER=log (for testing only)
SMS_ALLOW_LOG=0
# Most SMS per day for the whole server (protects your SMS credit)
SMS_DAILY_MAX=300
# Code lifetime, wait before a new code, codes per number per hour, digits
OTP_TTL=180
OTP_RESEND=60
OTP_MAX_PER_HOUR=5
OTP_LENGTH=5

# Google sign-in (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Authorized redirect URI: https://YOUR-API-DOMAIN/api/hefz/oauth-done
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
